# Pete’s Trading. Copy to .env ON THE SERVER ONLY. Never commit .env or paste keys into chat.

# ---------------------------------------------------------------- mode
# simulated – made-up prices and a pretend broker (default, no keys needed)
# paper     – real prices + Trading 212 PRACTICE account (no real money)
# live      – real prices + Trading 212 REAL-MONEY account
TRADING_MODE=simulated

# Required for paper and live (24+ random characters). Generate: openssl rand -base64 32
APP_ACCESS_TOKEN=

PORT=8787
# DATA_DIR=./data

# ---------------------------------------------------------------- prices (paper / live)
# Free key from alphavantage.co (about 25 requests/day – the app uses ~9 a day).
ALPHAVANTAGE_API_KEY=

# ---------------------------------------------------------------- Trading 212
# Create keys in the Trading 212 app (API settings). Give them ONLY these permissions:
#   account, portfolio, orders:read, orders:execute, history:orders, metadata
# and restrict them to your server's IP address.
# Practice account (paper mode):
T212_DEMO_API_KEY=
T212_DEMO_API_SECRET=
# Real-money account (live mode only – the server refuses to start if these are set in any other mode):
# T212_LIVE_API_KEY=
# T212_LIVE_API_SECRET=
# Live mode also needs this exact sentence:
# LIVE_TRADING_ACK=I accept that this trades real money

# ---------------------------------------------------------------- phone notifications (pick one)
# ntfy: install the ntfy app, subscribe to a long random topic, put its URL here.
NTFY_URL=
# NTFY_TOKEN=
# Telegram: create a bot with @BotFather, then message it and get your chat id.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# ---------------------------------------------------------------- risk (can only make things tighter than the code's ceilings)
# RISK_MAX_PER_TRADE_GBP=0.50
# RISK_MAX_POSITION_GBP=12.50
# RISK_MAX_DAILY_LOSS_GBP=1.50
# RISK_MAX_CAPITAL_GBP=50        # most the app will have invested at once, whatever the account holds
# RISK_EQUITY_FLOOR_GBP=45       # emergency stop if the account value falls to this
# PROPOSAL_TTL_SECONDS=1800      # how long a trade idea waits for your approval
# ENTRY_LIMIT_BUFFER_BPS=50      # limit price = last close + 0.5%

# ---------------------------------------------------------------- AI explanations (optional)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
AI_MAX_CALLS_PER_DAY=10
AI_MAX_COST_PER_DAY_GBP=0.05
