# AI Trading Copilot – Phase 1 (DEMO ONLY). Copy to .env on the SERVER. Never commit .env.

# Only "demo" is accepted. Any other value, or any T212_LIVE_* / LIVE_TRADING variable, stops the server.
TRADING_MODE=demo

PORT=8787
# DATA_DIR=./data

# Required when NODE_ENV=production (24+ random characters). The phone app asks for it once.
# Generate with: openssl rand -base64 32
APP_ACCESS_TOKEN=

# Optional: Claude explanations. Without it the free rules-based template is used.
ANTHROPIC_API_KEY=
# Default claude-opus-5-5. claude-haiku-5-5 costs roughly 40x less per explanation.
CLAUDE_MODEL=claude-opus-5-5
AI_MAX_CALLS_PER_DAY=10
AI_MAX_COST_PER_DAY_GBP=0.05

# Phase 1 only allows BROKER=simulated. t212-demo is refused while MARKET_DATA=simulated.
BROKER=simulated
MARKET_DATA=simulated
# Trading 212 PAPER (demo) keys – only needed in Phase 2. Never put live keys here.
T212_DEMO_API_KEY=
T212_DEMO_API_SECRET=

# Risk limits can be tightened here; values above the hard ceilings in code are clamped.
# RISK_MAX_PER_TRADE_GBP=0.50
# RISK_MAX_POSITION_GBP=12.50
# RISK_MAX_DAILY_LOSS_GBP=1.50
# PROPOSAL_TTL_SECONDS=600

# Simulation timing
# SCAN_INTERVAL_SECONDS=30
# TICK_INTERVAL_SECONDS=3
# SIM_BAR_SECONDS=15
